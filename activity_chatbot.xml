<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fitsSystemWindows="true">

    <!-- ================= APP BAR ================= -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="#1E3A8A"
        app:title="MediAI Assistant"
        app:titleCentered="false"
        app:titleTextColor="#FFFFFF"
        app:subtitle="AI Health Chat"
        app:subtitleTextColor="#D1D5DB"
        app:navigationIcon="@drawable/ic_back_arrow"
        app:menu="@menu/chat_menu"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ================= CHAT LIST ================= -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="12dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="90dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/chat_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ================= INPUT BAR ================= -->
    <androidx.cardview.widget.CardView
        android:id="@+id/chat_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical">

            <!-- VOICE BUTTON -->
            <ImageButton
                android:id="@+id/voice_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:background="@android:color/transparent"
                android:contentDescription="Voice"
                app:tint="#1E3A8A"/>

            <!-- TEXT INPUT -->
            <EditText
                android:id="@+id/message_input"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Ask MediAI..."
                android:padding="10dp"
                android:background="@android:color/transparent"
                android:textColor="#000000"
                android:textColorHint="#9CA3AF"/>

            <!-- SEND BUTTON -->
            <ImageButton
                android:id="@+id/send_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_send"
                android:background="@drawable/bg_send_circle"
                android:contentDescription="Send"
                app:tint="#FFFFFF"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
